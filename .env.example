POSTGRES_DB=anklav
POSTGRES_USER=anklav
POSTGRES_PASSWORD=replace-this-postgres-password
DATABASE_URL=postgresql://anklav:replace-this-postgres-password@postgres:5432/anklav
# Generate with: openssl rand -base64 32
ANKLAV_SETUP_TOKEN=replace-with-a-long-random-token
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:8080
# GitHub stays disabled until this is explicitly enabled. Production needs a public HTTPS URL.
GITHUB_INTEGRATION_ENABLED=false
PUBLIC_BASE_URL=http://localhost:8080
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
# Optional OpenAI-compatible embedding endpoint. Keep unset for lexical-only retrieval.
# Start the document worker with: docker compose --profile embedding up -d --build
# EMBEDDING_BASE_URL=http://host.docker.internal:8081/v1
# EMBEDDING_API_KEY=
# Must match the active profile's immutable model revision.
# EMBEDDING_MODEL_REVISION=1066b6599d099fbb93dfcb64f9c37a7c9e503e85
